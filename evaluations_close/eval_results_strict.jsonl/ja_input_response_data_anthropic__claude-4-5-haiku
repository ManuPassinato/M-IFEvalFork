71\u97ff\uff1a\u7c73\u56fd\u3078\u306e\u5f71\u97ff\n\n### \u6d88\u8cbb\u8005\u3078\u306e\u8ca0\u62c5\u5897\u52a0\n\u95a2\u7a0e\u306f\u6700\u7d42\u7684\u306b\u6d88\u8cbb\u8005\u8ca0\u62c5\u3068\u306a\u308a\u3001\u4ee5\u4e0b\u306e\u5f71\u97ff\u304c\u751f\u3058\u307e\u3057\u305f\uff1a\n- **\u7269\u4fa1\u4e0a\u6607**\uff1a\u5bb6\u96fb\u88fd\u54c1\u3001\u8863\u6599\u54c1\u3001\u5bb6\u5177\u306a\u3069\u306e\u4fa1\u683c\u304c\u4e0a\u6607\n- **\u8cfc\u8cb7\u529b\u306e\u4f4e\u4e0b**\uff1a\u7279\u306b\u4f4e\u6240\u5f97\u5c64\u3078\u306e\u5f71\u97ff\u304c\u5927\u304d\u304b\u3063\u305f\n\n### \u4f01\u696d\u3078\u306e\u5f71\u97ff\n- **\u30b5\u30d7\u30e9\u30a4\u30c1\u30a7\u30fc\u30f3\u306e\u6df7\u4e71**\uff1a\u4e2d\u56fd\u304b\u3089\u306e\u90e8\u54c1\u8abf\u9054\u304c\u56f0\u96e3\u306b\n- **\u5229\u76ca\u7387\u306e\u4f4e\u4e0b**\uff1a\u95a2\u7a0e\u8ca0\u62c5\u306b\u3088\u308a\u4f01\u696d\u5229\u76ca\u304c\u5727\u8feb\n- **\u6295\u8cc7\u306e\u840e\u7e2e**\uff1a\u4e0d\u78ba\u5b9f\u6027\u306e\u5897\u52a0\u306b\u3088\u308a\u4f01\u696d\u6295\u8cc7\u304c\u6e1b\u5c11\n\n### \u8fb2\u696d\u90e8\u9580\u3078\u306e\u6253\u6483\n- \u4e2d\u56fd\u306b\u3088\u308b\u5831\u5fa9\u95a2\u7a0e\u3067\u7c73\u56fd\u8fb2\u7523\u7269\u306e\u8f38\u51fa\u304c\u5927\u5e45\u6e1b\u5c11\n- \u5927\u8c46\u8fb2\u5bb6\u304c\u7279\u306b\u6df1\u523b\u306a\u5f71\u97ff\u3092\u53d7\u3051\u3001\u653f\u5e9c\u88dc\u52a9\u91d1\u304c\u5fc5\u8981\u306b\n- \u8fb2\u6751\u5730\u57df\u306e\u7d4c\u6e08\u304c\u60aa\u5316\n\n### GDP\u6210\u9577\u7387\u3078\u306e\u5f71\u97ff\n- 2018\u5e74\u306e\u6210\u9577\u7387\u306f2.9%\u3067\u3057\u305f\u304c\u3001\u305d\u306e\u5f8c\u306e\u6210\u9577\u7387\u306f\u920d\u5316\n- 2019\u5e74\u306e\u6210\u9577\u7387\u306f2.2%\u306b\u4f4e\u4e0b\n\n---\n\n## \u7b2c4\u7bc0 \u7d4c\u6e08\u7684\u5f71\u97ff\uff1a\u4e2d\u56fd\u3078\u306e\u5f71\u97ff\n\n### \u8f38\u51fa\u7523\u696d\u3078\u306e\u6253\u6483\n- **\u88fd\u9020\u696d\u306e\u6e1b\u901f**\uff1a\u7c73\u56fd\u5411\u3051\u8f38\u51fa\u304c\u6e1b\u5c11\u3057\u3001\u88fd\u9020\u696dPMI\uff08\u8cfc\u8cb7\u62c5\u5f53\u8005\u666f\u6c17\u6307\u6570\uff09\u304c\u4f4e\u4e0b\n- **\u5931\u696d\u7387\u306e\u4e0a\u6607**\uff1a\u7279\u306b\u52b4\u50cd\u96c6\u7d04\u7684\u7523\u696d\u3067\u96c7\u7528\u304c\u6e1b\u5c11\n\n### \u7d4c\u6e08\u6210\u9577\u7387\u306e\u920d\u5316\n- \u4e2d\u56fd\u306eGDP\u6210\u9577\u7387\u306f2018\u5e74\u306e6.6%\u304b\u30892019\u5e74\u306b\u306f6.1%\u306b\u4f4e\u4e0b\n- \u9577\u671f\u7684\u306b\u306f\u6f5c\u5728\u6210\u9577\u7387\u306e\u4f4e\u4e0b\u306b\u3064\u306a\u304c\u308b\u61f8\u5ff5\n\n### \u901a\u8ca8\u3078\u306e\u5727\u529b\n- \u4eba\u6c11\u5143\u304c\u4e0b\u843d\u5727\u529b\u3092\u53d7\u3051\u30012019\u5e748\u6708\u306b\u306f1\u30c9\u30eb=7\u5143\u3092\u7a81\u7834\n- \u8cc7\u672c\u6d41\u51fa\u306e\u61f8\u5ff5\u304c\u751f\u3058\u307e\u3057\u305f\n\n### \u7523\u696d\u69cb\u9020\u3078\u306e\u5f71\u97ff\n- \u4f4e\u4ed8\u52a0\u4fa1\u5024\u7523\u696d\u304b\u3089\u9ad8\u4ed8\u52a0\u4fa1\u5024\u7523\u696d\u3078\u306e\u8ee2\u63db\u304c\u52a0\u901f\n- \u6280\u8853\u958b\u767a\u3078\u306e\u6295\u8cc7\u304c\u5897\u52a0\n\n---\n\n## \u7b2c5\u7bc0 \u30b0\u30ed\u30fc\u30d0\u30eb\u7d4c\u6e08\u3078\u306e\u6ce2\u53ca\u52b9\u679c\u3068\u4eca\u5f8c\u306e\u5c55\u671b\n\n### \u4e16\u754c\u7d4c\u6e08\u3078\u306e\u60aa\u5f71\u97ff\n- **\u30b5\u30d7\u30e9\u30a4\u30c1\u30a7\u30fc\u30f3\u306e\u518d\u7de8**\uff1a\u4f01\u696d\u304c\u4e2d\u56fd\u4ee5\u5916\u3078\u306e\u751f\u7523\u62e0\u70b9\u79fb\u8ee2\u3092\u691c\u8a0e\n- **\u4e16\u754c\u8cbf\u6613\u306e\u7e2e\u5c0f**\uff1aWTO\u7d71\u8a08\u306b\u3088\u308b\u3068\u3001\u4e16\u754c\u8cbf\u6613\u6210\u9577\u7387\u304c\u920d\u5316\n- **\u65b0\u8208\u56fd\u3078\u306e\u5f71\u97ff**\uff1a\u4e2d\u56fd\u7d4c\u7531\u3067\u7c73\u56fd\u306b\u8f38\u51fa\u3057\u3066\u3044\u305f\u56fd\u3005\u304c\u6253\u6483\u3092\u53d7\u3051\u305f\n\n### \u591a\u56fd\u9593\u4e3b\u7fa9\u306e\u5371\u6a5f\n- \u4e8c\u56fd\u9593\u4ea4\u6e09\u306e\u91cd\u8996\u306b\u3088\u308a\u3001WTO\u306a\u3069\u591a\u56f